# —— 引导/身份 ——
# 留空 ADMIN_USERNAME 或 ADMIN_PASSWORD 时，首次启动进入安装向导
ADMIN_USERNAME=
ADMIN_PASSWORD=
JWT_SECRET=

# —— 站点 ——
# 对外链接拼接域名（默认 http://HOST:PORT）
SITE_BASE_URL=
# 允许匿名使用（true/false，默认 true）
ALLOW_ANONYMOUS=true

# —— 大模型服务（安装向导第 3 步会写入） ——
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# —— 存储 ——
DATA_ROOT=./data
HOST=127.0.0.1
PORT=8217
